---
/**
 * MetricCard — Small card displaying a single redistricting metric.
 * Shows the metric name, value, and a brief description.
 * Used in the editor sidebar and fair maps comparison view.
 *
 * Props:
 *   label       — Metric display name (e.g., "Polsby-Popper")
 *   value       — Formatted metric value (e.g., "0.42")
 *   description — One-line explanation of what the metric means
 *   status      — Optional visual status: 'good', 'warning', or 'bad'
 */

interface Props {
  label: string;
  value: string;
  description: string;
  status?: 'good' | 'warning' | 'bad';
}

const { label, value, description, status } = Astro.props;

/** Status is shown as a dot plus screen-reader text, not a colored card edge */
const statusDot = {
  good: 'bg-green-500',
  warning: 'bg-yellow-500',
  bad: 'bg-red-500',
};
const statusLabel = { good: 'Good', warning: 'Warning', bad: 'Concerning' };
---

<div class="p-4 bg-white rounded-lg border border-mo-neutral-200">
  <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-mo-neutral-600 mb-1">
    {status && <span class={`inline-block w-2 h-2 rounded-full ${statusDot[status]}`} aria-hidden="true" />}
    {label}
    {status && <span class="sr-only">({statusLabel[status]})</span>}
  </div>
  <div class="text-2xl font-bold text-mo-neutral-800 mb-1">
    {value}
  </div>
  <div class="text-xs text-mo-neutral-600">
    {description}
  </div>
</div>
